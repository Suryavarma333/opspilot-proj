# Non-secret OpsPilot Part 2 integration settings.
OPSPILOT_INTEGRATION_MODE=draft
OPSPILOT_JIRA_URL=https://your-domain.atlassian.net
OPSPILOT_JIRA_PROJECT_KEY=OPS
OPSPILOT_JIRA_REQUESTED_LABEL=opspilot
OPSPILOT_JIRA_ISSUE_TYPE=INCIDENT
OPSPILOT_JIRA_BUSINESS_UNIT_FIELD_ID=customfield_12345
OPSPILOT_GOOGLE_CHAT_SPACE=NOC-Alerts
OPSPILOT_MEET_URL=https://meet.google.com/your-bridge
OPSPILOT_ROSTER_CSV_PATH=/var/lib/opspilot-dashboard-agent/current-oncall.csv

# Optional alternative to the local roster CSV.
# OPSPILOT_ROSTER_SHEET_ID=
# OPSPILOT_ROSTER_SHEET_GID=0

# Configure these secrets only through configure-integrations.sh on the VM.
# OPSPILOT_JIRA_EMAIL=
# OPSPILOT_JIRA_API_TOKEN=
# OPSPILOT_CHAT_WEBHOOK_URL=
# OPSPILOT_ACTION_TOKEN=
