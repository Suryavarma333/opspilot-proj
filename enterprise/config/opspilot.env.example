OPSPILOT_ENVIRONMENT=production
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_STATE_DB=/var/lib/opspilot-enterprise/opspilot.sqlite3
OPSPILOT_EVIDENCE_DIR=/var/lib/opspilot-enterprise/evidence
OPSPILOT_API_HOST=127.0.0.1
OPSPILOT_API_PORT=8088
OPSPILOT_WEBHOOK_HMAC_SECRET=replace-with-32-or-more-random-bytes
OPSPILOT_APPROVAL_HMAC_SECRET=replace-with-a-different-32-or-more-random-bytes
OPSPILOT_WEBHOOK_REPLAY_SECONDS=300

OPSPILOT_TELEMETRY_COMMAND_TIMEOUT_SECONDS=15
OPSPILOT_TELEMETRY_TOTAL_BUDGET_SECONDS=45
OPSPILOT_TELEMETRY_MAX_COMMAND_BYTES=512000
OPSPILOT_TELEMETRY_MAX_PROCESSES=4096
OPSPILOT_TELEMETRY_CPU_SAMPLE_SECONDS=0.5

OPSPILOT_HISTORY_WINDOW_DAYS=30
OPSPILOT_FLAPPING_WINDOW_DAYS=7
OPSPILOT_FLAPPING_CYCLE_THRESHOLD=5
OPSPILOT_HISTORY_EVENT_LIMIT=100

OPSPILOT_BHARATROUTER_BASE_URL=https://api.bharatrouter.com/v1
OPSPILOT_BHARATROUTER_API_KEY=replace-with-br-key
OPSPILOT_LLM_MODEL=qwen2.5-7b-instruct
OPSPILOT_LLM_OPTIMIZE=uptime
OPSPILOT_LLM_DATA_POLICY=india_only
OPSPILOT_LLM_TIMEOUT_SECONDS=90
OPSPILOT_LLM_MAX_OUTPUT_TOKENS=2800
OPSPILOT_LLM_RESPONSE_FORMAT=json_schema

OPSPILOT_ROUTER_BASE_URL=https://router-controller.internal.example
OPSPILOT_ROUTER_API_KEY=replace-with-read-only-router-key
OPSPILOT_ROUTER_AUTH_HEADER=X-API-Key
OPSPILOT_ROUTER_DEVICE_ID=edge-router-01
OPSPILOT_ROUTER_INTERFACES_PATH=/v1/devices/{device_id}/interfaces
OPSPILOT_ROUTER_TIMEOUT_SECONDS=10

OPSPILOT_JIRA_BASE_URL=https://example.atlassian.net
OPSPILOT_JIRA_PROJECT_KEY=CORE
OPSPILOT_JIRA_ISSUE_TYPE=Incident
OPSPILOT_JIRA_USER_EMAIL=opspilot-service@example.com
OPSPILOT_JIRA_API_TOKEN=replace-with-project-scoped-token

OPSPILOT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/secret

OPSPILOT_REMEDIATION_MODE=disabled
OPSPILOT_REMEDIATION_ALLOWED_SERVICES=[]
OPSPILOT_REMEDIATION_AUTO_RUNBOOKS=[]
OPSPILOT_REMEDIATION_APPROVAL_TTL_SECONDS=600

OPSPILOT_WORKER_POLL_SECONDS=1
OPSPILOT_WORKER_LEASE_SECONDS=900
OPSPILOT_ALLOW_INSECURE_HTTP=false

